{
  "compilerOptions": {
    "composite": true,
    // Composite projects must emit. Park the output away from the repo root:
    // a stray `vite.config.js` there would shadow `vite.config.ts`.
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "strict": true
  },
  "include": ["vite.config.ts", "server/**/*.d.mts"]
}
