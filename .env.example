# Copy to `.env` and fill in. These stay on the server side — the Vite dev
# middleware and the production Express server read them, the browser never
# sees the key.

# Any OpenAI-compatible endpoint. Give the root that holds /chat/completions.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# How many merged-config paths go into one request. Lower it if the upstream
# model has a small context window.
LLM_PATHS_PER_BATCH=60

# Port the production Express server listens on (`npm start`).
PORT=8787

# Debug logging for the LLM proxy. When set, each /analyze request writes a
# few JSON files here so you can inspect the exact prompt, upstream response,
# finish_reason, usage, and the client-side parse coverage. Leave unset to
# disable. Path is server-side only and is never exposed to the browser.
# LLM_LOG_DIR=./logs

# ---------- Persistence ------------------------------------------------------
# Postgres connection string. Every ingested journey, its per-variant build,
# LLM verdicts, distilled schema, generated YAML and converter code are
# persisted under the journey's folder name.
#
# Compose runs Postgres for you and overrides this to the docker network name;
# for local dev, run your own Postgres and use a URL like the one below.
# Leave empty to disable persistence entirely — the app still works.
DATABASE_URL=postgres://afra:afra@localhost:5432/afra
# DATABASE_POOL_MAX=8
