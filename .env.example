# Copy to `.env` and fill in. These stay on the server side — the Vite dev
# middleware and the production Express server read them, the browser never
# sees the key.

# Any OpenAI-compatible endpoint. Give the root that holds /chat/completions.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# How many merged-config paths go into one request. Lower it if the upstream
# model has a small context window.
LLM_PATHS_PER_BATCH=60

# Port the production Express server listens on (`npm start`).
PORT=8787
